{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ishaqzada-delivery",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ishaqzada-delivery-db",
      "database_id": "PASTE_D1_DATABASE_ID_HERE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "ishaqzada-delivery-photos"
    }
  ],
  "vars": {
    "ADMIN_NAME": "اډمین",
    "ADMIN_PHONE": "0700426319",
    "ADMIN_PIN": "1234"
  }
}